# Copy to .env and fill in LLM_API_KEY. Only asking new questions needs these;
# tests, replay and `check` need no key.
# Any OpenAI-compatible Chat Completions endpoint works, e.g. https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# "none": gpt-6 models accept function tools in Chat Completions only without reasoning
LLM_REASONING_EFFORT=none
# Development only (model list and prices); the application never reads it:
# OPENROUTER_API_KEY=
