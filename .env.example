# Copy to .env (./start.sh does it), then fill in ONE block below with your own key.
# Only asking new questions needs a key; the demo chats, replay, tests and `check` work without one.
# Never put a key in this file: it is committed. .env is gitignored.

# --- OpenAI (the default, used for the evaluation) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# "none": gpt-6 models accept function tools in Chat Completions only without reasoning
LLM_REASONING_EFFORT=none

# --- Anthropic (Claude): comment out the OpenAI block above and use this one ---
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5
# LLM_REASONING_EFFORT=
# Claude 5 models (claude-sonnet-5-5, ...) think by default, and forced tool calls need thinking off:
# LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# --- Any other OpenAI-compatible endpoint (OpenRouter, Gemini, Groq, a local Ollama, ...) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
# LLM_REASONING_EFFORT=

# Optional for every provider: the output cap per model call (default 4096; a report needs about 1k)
# LLM_MAX_TOKENS=4096

# Development only (model list and prices); the application never reads it:
# OPENROUTER_API_KEY=
